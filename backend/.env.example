APP_NAME=Ashu API
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000

# Clerk: same Google-authenticated identity as the existing Next.js frontend.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase project. Use the publishable key for user-scoped PostgREST calls.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key; only background worker/admin tasks may use this.
SUPABASE_SECRET_KEY=
# Direct Postgres URL for PGMQ worker. Use a role with only required permissions.
SUPABASE_DATABASE_URL=

# Encryption key: generate with `python scripts/generate_secret.py`.
INTEGRATION_ENCRYPTION_KEY=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Digiicampus: disabled until the Bhawanipur tenant endpoints and access are verified.
DIGII_BASE_URL=https://bhawanipurglobal.digiicampus.com
DIGII_READONLY_ENABLED=false
DIGII_AUTH_TOKEN=
DIGII_ALLOWED_HOST=bhawanipurglobal.digiicampus.com
# Configure paths only after verifying them against Bhawanipur's own API responses.
DIGII_PROFILE_PATH=
DIGII_COURSES_PATH=
DIGII_ASSIGNMENTS_PATH=
DIGII_ASSIGNMENT_DETAIL_PATH=
DIGII_RESOURCES_PATH=
DIGII_MODULES_PATH=
DIGII_SESSIONS_PATH=
DIGII_FEED_PATH=
DIGII_CALENDAR_PATH=
DIGII_NOTIFICATIONS_PATH=

DIGII_SYNC_INTERVAL_MINUTES=15
MAX_UPLOAD_BYTES=20971520

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Worker
WORKER_POLL_SECONDS=3
WORKER_VISIBILITY_TIMEOUT=900
WORKER_BATCH_SIZE=5
